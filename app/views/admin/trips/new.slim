h1 Add Trip
= form_for :trip, url: admin_trips_path, method: :post do |f|
  div
    = f.label t('structs.trip.path')
    = f.text_field :path
  div
    = f.label t('structs.trip.cost')
    = f.number_field :cost
  div
    = f.label t('structs.trip.departure_address')
    = f.text_field :departure_address
  div
    = f.label t('structs.trip.destination_address')
    = f.text_field :destination_address
  div
    = f.label t('structs.trip.departure')
    = text_field_tag 'trip[departure][]'
    = text_field_tag 'trip[departure][]'
  div
    = f.label t('structs.trip.destination')
    = text_field_tag 'trip[destination][]'
    = text_field_tag 'trip[destination][]'
  div
    = f.label t('structs.trip.user')
    = f.select :user_id, @users.collect { |u| [u.phone_number, u.id] }
  div
    = f.submit 'Add'
    = link_to 'Back', admin_trips_path
