h1 Trips

div
  p = link_to 'Add new trip', new_admin_trip_path

table
  tr
    th= t('structs.trip.id')
    th= t('structs.trip.path')
    th= t('structs.trip.cost')
    th= t('structs.trip.departure_address')
    th= t('structs.trip.destination_address')
    th= t('structs.trip.departure')
    th= t('structs.trip.destination')
  - @trips.each do |trip|
    tr
      td= trip.id
      td= trip.path
      td= trip.cost
      td= trip.departure_address
      td= trip.destination_address
      td= trip.departure
      td= trip.destination
      td= button_to 'Cancel', admin_trip_path(trip.id), method: :delete if trip.status.in?([0, 1])
