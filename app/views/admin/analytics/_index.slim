script src="https://unpkg.com/frappe-charts@1.1.0"

h1 Analytics
/! Tab links
.tab
  button.tablinks onclick="openTab(event, 'days')" id="defaultOpen"  By Days
  button.tablinks onclick="openTab(event, 'hours')"  By Hours
  button.tablinks onclick="openTab(event, 'fooBar')"  By FooBar        

#days.tabcontent
  h2 Trips count by days
  .sidebar
    .sidebar_section.panel
      .panel_contents
        = form_tag admin_analytics_path, method: :get, class: 'filter_form' do
          .date_range.filter_form_field.filter_date_range
            .range
              label.label From
              = text_field_tag :from, params[:from] || 1.day.ago.to_date, type: :date, class: "datepicker hasDatepicker"
            .range
              label.label To
              = text_field_tag :to, params[:to] || Time.now.to_date, type: :date, class: "datepicker hasDatepicker"
            .range
              label.label Chart Type
              = select_tag "type", options_for_select([ 'days', 'hours' ], 'days')
            .check  
              ul#checkboxes
                li  
                  = check_box_tag 'status[]', 4
                  = h 'finished'
                li
                  = check_box_tag 'status[]', 5
                  = h 'canceled'
                li
                  = check_box_tag 'status[]', 6
                  = h 'declined'
                li
                  = check_box_tag 'status[]', 7
                  = h 'canceled by driver' 
            = params[:days]       

          = submit_tag "Send", class: 'send-button'
  .analytics data-page='analytics'
    #daysChart
  - @trips.each do |trip|
    div.js-trip data-trips=trip.to_json        

