link href='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css' rel='stylesheet'

.dashboard data-page='dashboard'
  .map#map
  ul.trips
    - @trips.each do |trip|
      li.trips__card data-trip=trip.to_json
        = link_to admin_trip_path(trip)
          .field
            ' ♻️
            = trip.status
          - trip.stops.each do |address|
            .field
              '📍
              = address
          .field = "👤 #{trip.user_phone_number}"
          .field
            ' 🚖
            => trip.car&.number
            = trip.driver&.name
          .field
            ' 💲
            => trip.cost
            ' ⏰
            = trip.start_at&.strftime("%H:%M") || '❓'

- @cars.each do |car|
  div.js-car data-info=car.to_json

.car-icon
  = inline_svg 'car-black'

- @drivers.each do |driver|
  div.driver data-drivers=driver.to_json
