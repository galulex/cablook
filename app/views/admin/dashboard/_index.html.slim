script src='https://api.tiles.mapbox.com/mapbox-gl-js/v0.43.0/mapbox-gl.js'
link href='https://api.tiles.mapbox.com/mapbox-gl-js/v0.43.0/mapbox-gl.css' rel='stylesheet'

.dashboard data-page='dashboard'
  .map#map
  ul.trips
    - @trips.each do |trip|
      li.trips__card
        .field
          strong' Status:
          span=Constants::Trip::STATUS_CODES[trip.status]
        .field
          strong' Departure:
          span=trip.departure_address
        .field
          strong' Destination:
          span=trip.destination_address
        .field
          strong' Cost:
          span=trip.cost
        .field
          strong' User:
          span=trip.user.phone_number


- @cars.each do |car|
  div.js-car data-info=car.to_json
