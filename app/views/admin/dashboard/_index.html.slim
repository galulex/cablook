link href='https://api.tiles.mapbox.com/mapbox-gl-js/v0.43.0/mapbox-gl.css' rel='stylesheet'

.dashboard data-page='dashboard'
  .map#map
  ul.trips
    - @trips.each do |trip|
      li.trips__card data-trip=trip.to_json
        .field
          strong' Status:
          span.status=Constants::Trip::STATUS_CODES[trip.status]
        .field
          strong' Departure:
          span=trip.departure_address
        .field
          strong' Destination:
          span=trip.destination_address
        .field
          strong' Cost:
          span=trip.cost
        .field
          strong' User:
          span=trip.user_number

- @cars.each do |car|
  div.js-car data-info=car.to_json

.car-icon
  = inline_svg 'car-black'
