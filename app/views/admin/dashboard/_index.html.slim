link href='https://api.mapbox.com/mapbox-gl-js/v1.12.0/mapbox-gl.css' rel='stylesheet'

.dashboard data-page='dashboard'
  .map#map
  ul.trips
    - @trips.each do |trip|
      li.trips__card data-trip=trip.to_json
        .field
          strong> Status:
          span.status=trip.status
        .field
          strong> Departure:
          span=trip.departure_address
        .field
          strong> Destination:
          span=trip.destination_address
        .field
          strong> Cost:
          span=trip.cost
        .field
          strong> User:
          span=trip.user_phone_number
        .field
          strong> Driver:
          span=trip.driver.name
        .field
          strong> Car number:
          span=trip.car.number
        - unless trip.start_at.blank?
          .field
            strong> Start time:
            span=trip.start_at.strftime("%a, %d, %H:%M")

- @cars.each do |car|
  div.js-car data-info=car.to_json

.car-icon
  = inline_svg 'car-black'

- @drivers.each do |driver|
  div.driver data-drivers=driver.to_json
