= form_with url: admin_notifications_notify_path, method: :post, class: 'filter_form' do |f|
  .filter
    = f.label :ua
    = f.text_field :ua, required: true
  .filter
    = f.label :ru
    = f.text_field :ru, required: true
  .filter
    = f.label :en
    = f.text_field :en, required: true
  .filter
    = f.label :user
    select#phoneNumber style=('width: 100%')

  = submit_tag 'Send', class: 'send-button'

javascript:
  $(document).ready(function() {
    $('select#phoneNumber').select2({
      ajax: {
        url: '/admin/notifications/test_json',
        dataType: 'json',
        delay: 250,
        processResults: function (data) {
          return {
            results: $.map(data, function(obj) {
              return { id: obj.id, text: obj.phone_number };
            })
          };
        }
      },
      placeholder: 'Search for a user',
      minimumInputLength: 3
    });
  })
