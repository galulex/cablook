h1 Cars

= link_to 'Add new car', new_admin_car_path

table
  tr
    th = t('structs.car.id')
    th = t('structs.car.number')
    th = t('structs.car.status')
  - @cars.each do |car|
    tr
      td= car.id
      td= car.number
      td= car.status
      td= button_to 'Delete', admin_car_path(car.id), method: :delete
