doctype 5
html lang="#{I18n.locale}"
  head
    = render 'layouts/head'
    css:
      html {
        overflow-x: hidden;
      }

      * {
        box-sizing: border-box;
      }

      *[disabled] { display: none; }

      button[disabled] {
        opacity: 0.5;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: Gilroy, Helvetica, Arial, sans-serif;
        font-weight: 100;
        font-size: 18px;
        background: white;
        color: #312d50;
        min-height: 100vh;
        -webkit-overflow-scrolling: touch;
      }

      header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background :#19A160;
        background: linear-gradient(to left, #19A160, #132d50);
        text-align: center;
        color: white;
        padding: 1rem 0;
        z-index: 100;
        height: 54px;
      }

      section {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        padding: 70px 30px 0;
      }

      ul {
        padding: 0;
        margin: 0;
        list-style: none;
      }

      main.login {
        background: #132d50;
        background: linear-gradient(to top, #19A160, 20%, #132d50);
      }

  body onload="document.getElementById('styles').rel = 'stylesheet'"
    link#styles href=asset_path('pwa.css') rel=:preload as=:style onload="this.rel='stylesheet'"
    = javascript_pack_tag 'pwa', async: true
    = render 'layouts/footer'
    script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDx2cLwlAG3muHMV9DVYY3l2PupoYCS-Mk&libraries=places" async=true
