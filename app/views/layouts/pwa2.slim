doctype 5
html lang="#{I18n.locale}"
  head
    = render 'layouts/head'
    = inline_svg 'filter_main.svg'
    = inline_svg 'filter_large.svg'
    meta name='theme-color' media='(prefers-color-scheme: light)' content='#eef6fb'
    meta name='theme-color' media='(prefers-color-scheme: dark)' content='#15121e'
    link rel='stylesheet' href=font_path('Gilroy-ExtraBold.woff2')  type='font/woff2'
    link rel='stylesheet' href=font_path('Gilroy-Bold.woff2') type='font/woff2'
    link rel='stylesheet' href=font_path('Gilroy-Light.woff2')  type='font/woff2'
    css:
      :root {
        --green: #19a160;
        --green_2: var(--green);
        --green_3: var(--green);
        --purple: #a925ad;
        --orange: #efcc3a;
        --orange_2: var(--orange);
        --navy: #312d50;
        --font_color_1: #777777;
        --font_color_2: #233038;
        --font_color_2_dark: #233038;
        --font_color_3: #D4D4D4;
        --grey: #d1d1d1;
        --black: #1c1c1c;
        --black_2: var(--black);
        --shadow: 0 3px 6px rgba(0,0,0,0.16);
        --focus-shadow: 0 3px 6px rgba(0,0,0,0.16), 0 3px 6px rgba(0,0,0,0.23);
        --body-bg: #eef6fb;
        --placeholder: rgba(49, 45, 80, 0.5);
        --map-bg: #e6e4e0;
        --pin-color: var(--green);
        --path-color: #19a160;
        --bg: rgba(255, 255, 255, 0.9);
        --zoom-level: 12;
        --car-transition: 0s;
        --container-background: rgba(255, 255, 255, .3);
        --button-background: rgba(255, 255, 255, .5);
        --orange-button-bg: rgba(255, 255, 255, .5);
        --comment-input-bg: rgba(238, 246, 251, 0.5);
        --address-input-bg: rgba(238, 246, 251, 0.8);
        --address-input-text: black;
        --navy-dark: var(--navy);
        --red-button-text: #cc0f34;
        --red-button-bg: rgba(255, 255, 255, .5);
        --trip-svg: rgba(119, 119, 119, .5);
        --transparent: rgba(255, 255, 255, 0);
        --line-color: #d6d6d6;
        --address-input-weight: 100;
        --main_background: linear-gradient(0deg, var(--bg_gradient_color_2), var(--bg_gradient_color_1), 40%);
        --main-shadow: 2px 2px 5px var(--shadow_color), inset -2px -2px 5px var(--shadow_color);
        --hover-shadow: 1px 1px 3px var(--shadow_color), inset -1px -1px 3px var(--shadow_color);
        --active-shadow: inset 2px 2px 5px var(--shadow_color), inset -2px -2px 5px var(--shadow_color_light);
        --green-hover-shadow: 2px 2px 5px var(--shadow_color), inset -2px -2px 5px 1px var(--shadow_color);
        --green-active-sahdow: inset 5px 5px 5px 1px var(--shadow_color), inset -2px -2px 5px 1px #4fb785;
        --minus-button-active-shadow: inset 2px 2px 5px 1px var(--shadow_color), inset -2px -2px 5px 1px var(--shadow_color);
        --btn-shadow-navy: 5px 3px 12px var(--shadow_color), inset -2px -2px 5px 1px var(--shadow_color);
        --item-border: 1px solid #ccc;
        --navigation-bg: linear-gradient(90deg, #19a160 150px, #19a160 150px, transparent 150px);
      }

      html {
        overflow: visible;
        overscroll-behavior-x: none;
        background: #eef6fb;
        background: var(--body-bg);
        height: 100%;
        transition: background .1s;
        -webkit-text-size-adjust: none;
        touch-action: manipulation;
        position: fixed;
      }

      * {
        box-sizing: border-box;
        font-family: Gilroy, Helvetica, Arial, sans-serif;
      }

      [disabled] {
        opacity: 0.5;
        pointer-events: none;
      }

      body {
        margin: 0;
        padding: 0;
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        font-family: Gilroy, Helvetica, Arial, sans-serif;
        font-weight: 100;
        font-size: 2.6vh;
        font-size: 2.6dvh;
        background: #eef6fb;
        background: var(--body-bg);
        background-attachment: fixed;
        color: #312d50;
        color: var(--navy);
        overscroll-behavior-x: none;
        height: 100%;
        -webkit-tap-highlight-color: transparent;
        -webkit-touch-callout: none;
        overflow-y: hidden;
      }

      main {
        padding: 0;
        margin: 0;
        display: flex;
        flex: 1 1 auto;
        flex-direction: row;
        flex-wrap: nowrap;
        align-items: stretch;
        align-content: stretch;
        height: 100%;
        overflow-x: auto;
        width: 100%;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior-x: contain;
        overflow-y: hidden;
        background: #e6efee;
        background: linear-gradient(to right, #e6efee, #f6faf8, #e6efee);
        background: var(--main_background);
      }

      main.disable-events,
      main.disable-events * {
        pointer-events: none;
      }

      main::-webkit-scrollbar {
        display: none;
      }

      main > div.general__holder {
        width: 100%;
        flex: 0 0 auto;
        flex-grow: 10;
        display: flex;
        justify-content: center;
        position: relative;
        scroll-snap-align: start;
        overflow: hidden;
        min-height: -webkit-fill-available;
        transition: opacity .1s;
        background: linear-gradient(0deg, #f6faf8, #e6efee);
        background: linear-gradient(0deg, var(--bg_gradient_color_1), var(--bg_gradient_color_2));
      }

      header {
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        background: transparent;
        text-align: center;
        font-size: 2.6vh;
        font-size: 2.6dvh;
        color: #233038;
        color: var(--font_color_2);
        height: 15vw;
        font-weight: 500;
      }

      header.hidden {
        z-index: -1 !important;
      }

      section {
        width: 100%;
        max-width: 600px;
        height: calc(100vh - 15vw);
        height: calc(100dvh - 15vw);
        padding: 0 3%;
        margin-top: 15vw;
        overflow-y: auto;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
      }

      ul {
        padding: 0;
        margin: 0;
        list-style: none;
      }

      form, div {
        position: relative;
      }

      iframe {
        background: white;
      }

      option {
        background: white;
        background: var(--white);
        color: #132d50;
        color: var(--navy);
        position: relative;
      }

      option:focus {
        background: #19a160;
        background: var(--green);
      }

      div.loader {
        background: #312d50;
        background: var(--navy);
        background: linear-gradient(to top, #19a160 -20%, #191730 70%);
        background: linear-gradient(to top, var(--green), 20%, #191730);
      }

      ::-webkit-input-placeholder {
        color: rgba(49, 45, 80, 0.5);
        color: var(--placeholder);
        font-weight: 300;
      }
      ::-moz-placeholder {
        color: rgba(49, 45, 80, 0.5);
        color: var(--placeholder);
        font-weight: 300;
      }
      :-ms-input-placeholder {
        color: rgba(49, 45, 80, 0.5);
        color: var(--placeholder);
        font-weight: 300;
      }
      :-moz-placeholder {
        color: rgba(49, 45, 80, 0.5);
        color: var(--placeholder);
        font-weight: 300;
      }

      div.loader {
        transition: opacity .5s .3s, visibility .0s .8s;
        position: fixed;
        z-index: 10000;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        overflow: hidden;
      }

      svg.search_logo {
        position: fixed;
        top: 50%;
        width: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        margin: 0;
        max-width: 200px;
      }

      svg#shadow_filter, svg#shadow_filter_large {
        position: absolute;
        width: 0;
        height: 0;
      }

      .pin path {
        filter: url(#inset-shadow) !important;
      }

      /* Search animation */
      .search_logo path:nth-child(1) { animation: green_logo 4s 0s infinite; }
      .search_logo path:nth-child(2) { animation: purple_logo 4s .5s infinite; }
      .search_logo path:nth-child(4) { animation: yellow_logo 4s 2.5s infinite; }
      .search_logo path:nth-child(3) { animation: yellow_logo 4s 1s infinite; }
      .search_logo path:nth-child(5) { animation: green_logo 4s 1.5s infinite; }
      .search_logo path:nth-child(6) { animation: purple_logo 4s 2s infinite; }
      .search_logo path:nth-child(7) { animation: yellow_logo 4s 3.5s infinite; }
      .search_logo path:nth-last-child(1) { animation: green_logo 4s 3s infinite; }

      @keyframes green_logo {
        10%, 25% { fill: #19A160; }
        25%, 100% { fill: white }
      }

      @keyframes purple_logo {
        10%, 25% { fill: #a925ad; }
        25%, 100% { fill: white }
      }

      @keyframes yellow_logo {
        10%, 25% { fill: #efcc3a; }
        25%, 100% { fill: white }
      }

      body.offline div.loader {
        transition: opacity .3s;
        visibility: visible;
        opacity: 1;
      }

      h1.offline {
        display: none;
        position: relative;
        text-align: center;
        z-index: 100000;
        color: white;
        color: var(--white);
      }

      body.offline h1.offline {
        display: block;
      }

      body.offline .search_logo path {
        animation: none !important;
      }

      @media (min-width: 450px) {
        header {
          height: 70px;
        }

        section {
          height: calc(100vh - 70px);
          height: calc(100dvh - 70px);
          margin-top: 70px;
        }
      }

      @media screen and (max-width: 540px) {
        section {
          padding: 0 10%;
        }
      }

      section::-webkit-scrollbar {
        height: 0;
        width: 0;
      }

      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
        background-color: rgba(0,0,0,0);
        -webkit-border-radius: 100px;
      }

      ::-webkit-scrollbar:hover {
        background-color: rgba(0, 0, 0, 0.09);
      }

      ::-webkit-scrollbar-thumb {
        background: rgba(0,0,0,0.3);
        -webkit-border-radius: 100px;
      }
      ::-webkit-scrollbar-thumb:active {
        background: rgba(0,0,0,0.6); / Some darker color when you click it */
        -webkit-border-radius: 100px;
      }

      main:after {
        content: '';
        position: fixed;
        z-index: 100000;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        overflow: hidden;
        background: transparent;
        width: 100%;
        pointer-events: none;
      }

      /* add vertical min-height & horizontal min-width */
      ::-webkit-scrollbar-thumb:vertical { min-height: 10px; }
      ::-webkit-scrollbar-thumb:horizontal { min-width: 10px; }

  body ontouchstart=''
    = render 'layouts/general_css_variables'
    h1.offline Offline
