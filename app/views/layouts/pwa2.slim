        <path fill="#FFF" d="M278.5 589.7L309 625l117.2-41.8c2-.7 1.4-3.8-.8-3.6l-146.9 10.1z"/>
        <path fill="#FFF" d="M316.6 639.2l116.7-46.1 36.8 79.2c1 2.2-.6 4.6-3 4.6H346.6l-30-37.7z"/>
      </svg>
    = javascript_pack_tag 'pwa', async: true
    = render 'layouts/footer'
    noscript
      h1.offline JavaScript is disabled :(
      css:
        .search_logo path {
          animation: none !important;
        }

        h1.offline {
          display: block;
        }
