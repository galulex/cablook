        <path fill="#FFF" d="M162 351.2c-3.9-10.9-17.5-41.4-55.9-41.4s-52 30.5-55.9 41.4-6.6 29.8-4.9 47.9c4.5 49.1 60.9 168.9 60.9 168.9s56.4-119.9 60.9-168.9c1.5-18.1-1.1-37-5.1-47.9z"/>
        <path fill="#FFF" d="M221.6 575.5l-18.5-18.1c-3.5-3.5-5.1-7.2-9.5-7.2l-51.3.5-11.2-.1c-14.3 31.6-25.7 54.6-25.7 54.6s-11.6-23.2-25.9-55l-11.9-.1H-.6c-4.4 0-8.3 2.9-9.5 7.2l-8.9 31.1L179.6 625l41.3-34.1c4.7-3.9 5-11.1.7-15.4z"/>
        <path fill="#FFF" d="M238.5 593.3l-99.6 83.6h189l-68.1-81.7c-5.3-6.5-14.9-7.3-21.3-1.9z"/>
        <path fill="#FFF" d="M7.3 607.4l-30.2-5.5-17.8 62.4c-.8 3-.3 6.2 1.6 8.7 1.9 2.5 4.8 3.9 7.9 3.9H7.3v-69.5z"/>
