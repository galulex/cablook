doctype 5
html lang="#{I18n.locale}"
  head
    = render 'layouts/head'
    link rel='preload' href=asset_path('Gilroy-ExtraBold.woff2') as='font' type='font/woff2' crossorigin='anonymous'
    link rel='preload' href=asset_path('Gilroy-Bold.woff2') as='font' type='font/woff2' crossorigin='anonymous'
    link rel='preload' href=asset_path('Gilroy-Light.woff2') as='font' type='font/woff2' crossorigin='anonymous'
    css:
      :root {
        --white: white;
        --green: #19a160;
        --purple: #a925ad;
        --orange: #efcc3a;
        --navy: #312d50;
        --grey: #d1d1d1;
        --black: #1c1c1c;
        --shadow: 0 3px 6px rgba(0,0,0,0.16);
        --focus-shadow: 0 3px 6px rgba(0,0,0,0.16), 0 3px 6px rgba(0,0,0,0.23);
        --body-bg: #132d50;
        --uk-flag-blue: #005bbb;
        --ru-flag-blue: #003da5;
        --en-flag-blue: #012169;
        --ru-flag-red: #da291c;
        --en-flag-red: #c8102e;
        --placeholder: rgba(49, 45, 80, 0.5);
        --map-bg: #e6e4e0;
        --pin-color: var(--green);
        --path-color: #19a160;
        --zoom-level: 12;
      }

      html {
        overflow: hidden;
        overscroll-behavior-x: none;
        background: #132d50;
        background: var(--body-bg);
        height: 100%;
        transition: background .1s;
      }

      * {
        box-sizing: border-box;
        font-family: Gilroy, Helvetica, Arial, sans-serif;
      }

      [disabled] {
        opacity: 0.5;
        pointer-events: none;
      }

      body {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        font-family: Gilroy, Helvetica, Arial, sans-serif;
        font-weight: 100;
        font-size: 18px;
        background: linear-gradient(to bottom, #d1d1d1, white);
        background: linear-gradient(to bottom, var(--grey), var(--white));
        background-attachment: fixed;
        color: #312d50;
        color: var(--navy);
        overscroll-behavior-x: none;
        height: 100%;
        -webkit-tap-highlight-color: transparent;
        -webkit-touch-callout: none;
        overflow-y: hidden;
      }

      main {
        height: 100vh;
        min-height: 100vh;
        min-height: calc(var(--vh, 1vh) * 100);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
      }

      header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: #19a160;
        background: var(--green);
        background: linear-gradient(to left, #19a160, #312d50);
        background: linear-gradient(to left, var(--green), #312d50);
        text-align: center;
        color: white;
        padding: 1rem 0;
        z-index: 100;
        height: 54px;
        font-weight: 500;
        box-shadow: 0 2px 2px 0 rgba(0,0,0,.14), 0 1px 5px 0 rgba(0,0,0,.12), 0 3px 1px -2px rgba(0,0,0,.2);
      }

      section {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        padding: 70px 30px 0;
        min-height: 100vh;
        min-height: calc(var(--vh, 1vh) * 100);
      }

      ul {
        padding: 0;
        margin: 0;
        list-style: none;
      }

      form, div {
        position: relative;
      }

      iframe {
        background: white;
      }

      div.loader {
        background: #312d50;
        background: var(--navy);
        background: linear-gradient(to top, #19a160 -20%, #312d50 70%);
        background: linear-gradient(to top, var(--green), 20%, #312d50);
      }

      ::-webkit-input-placeholder {
        color: rgba(49, 45, 80, 0.5);
        color: var(--placeholder);
        font-weight: 300;
      }
      ::-moz-placeholder {
        color: rgba(49, 45, 80, 0.5);
        color: var(--placeholder);
        font-weight: 300;
      }
      :-ms-input-placeholder {
        color: rgba(49, 45, 80, 0.5);
        color: var(--placeholder);
        font-weight: 300;
      }
      :-moz-placeholder {
        color: rgba(49, 45, 80, 0.5);
        color: var(--placeholder);
        font-weight: 300;
      }

      div.loader {
        transition: opacity .5s .3s, visibility .0s .8s;
        position: fixed;
        z-index: 10000;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        overflow: hidden;
      }

      svg.search_logo {
        position: fixed;
        top: 50%;
        width: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        margin: 0;
        max-width: 200px;
      }

      /* Search animation */
      .search_logo path:nth-child(1) { animation: green_logo 4s 0s infinite; }
      .search_logo path:nth-child(2) { animation: purple_logo 4s .5s infinite; }
      .search_logo path:nth-child(4) { animation: yellow_logo 4s 2.5s infinite; }
      .search_logo path:nth-child(3) { animation: yellow_logo 4s 1s infinite; }
      .search_logo path:nth-child(5) { animation: green_logo 4s 1.5s infinite; }
      .search_logo path:nth-child(6) { animation: purple_logo 4s 2s infinite; }
      .search_logo path:nth-child(7) { animation: yellow_logo 4s 3.5s infinite; }

      .search_logo path:nth-last-child(1) { animation: green_logo 4s 3s infinite; }


      @keyframes green_logo {
        10%, 25% { fill: #19A160; }
        25%, 100% { fill: white }
      }

      @keyframes purple_logo {
        10%, 25% { fill: #a925ad; }
        25%, 100% { fill: white }
      }

      @keyframes yellow_logo {
        10%, 25% { fill: #efcc3a; }
        25%, 100% { fill: white }
      }

      body.offline div.loader {
        transition: opacity .3s;
        visibility: visible;
        opacity: 1;
      }


      h1.offline {
        display: none;
        position: relative;
        text-align: center;
        z-index: 100000;
        color: white;
        color: var(--white);
      }

      body.offline h1.offline {
        display: block;
      }

      body.offline .search_logo path {
        animation: none !important;
      }

      @font-face {
        font-family: Gilroy;
        src: url("#{asset_path('Gilroy-Bold.woff2')}");
        font-weight: 400;
        font-display: swap;
      }

      @font-face {
        font-family: Gilroy;
        font-display: swap;
        font-weight: 700;
        src: url("#{asset_path('Gilroy-ExtraBold.woff2')}");
      }

      @font-face {
        font-family: Gilroy;
        src: url("#{asset_path('Gilroy-Light.woff2')}");
        font-weight: 100;
        font-display: swap;
      }

  body ontouchstart=''
