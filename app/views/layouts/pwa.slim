doctype html
html lang='uk'
  head
    = render 'layouts/head'
    css:
      html {
        overflow-x: hidden;
      }

      *[disabled] { display: none; }

      button[disabled] {
        opacity: 0.5;
      }

      body {
        overflow-x: hidden;
        background: #e1e1e1;
        background: linear-gradient(white, #d1d1d1);
        color: #1c1c1c;
        height: 100vh;
        -webkit-overflow-scrolling: touch;
      }

      main {
        width: 80%;
        height: 100%;
        max-width: 600px;
        margin: 0 auto;
        text-align: unset;
        padding-top: 50px;
        text-align: center;
        display: block;
      }

      .white-logo {
        max-width: 170px;
        width: 30%;
        display: block;
        margin: 0 auto;
      }

      .nissan {
        width: 60%;
        max-height: 150px;
        max-height: 150px;
      }

      .form__location-remove.link {
        display: none;
      }

      .form__location:nth-child(n+3) .link {
        display: block;
      }

      .form__location:nth-child(7) + button#add_point {
        display: none !important;
      }

      fieldset .loader {
        text-align: center;
      }

      fieldset .loader svg {
        max-width: 150px;
      }

      .hidden {
        display: none;
      }

  body
    main= yield
    = javascript_include_tag 'pwa', async: true
    = stylesheet_link_tag    'fonts', media: 'all'
    = stylesheet_link_tag 'pwa', media: :all
  = render 'layouts/footer'
