doctype 5
html lang="#{I18n.locale}"
  head
    = render 'layouts/head'
    css:
      html {
        overflow-x: hidden;
      }

      *[disabled] { display: none; }

      button[disabled] {
        opacity: 0.5;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: Gilroy, Helvetica, Arial, sans-serif;
        font-weight: 100;
        font-size: 18px;
        overflow-x: hidden;
        background: #312d50;
        background: linear-gradient(#312d50, 70%, #19a160);
        color: white;
        height: 100vh;
        -webkit-overflow-scrolling: touch;
      }

      main {
        width: 80%;
        max-height: 100%;
        max-width: 600px;
        margin: 0 auto;
        text-align: unset;
        padding-top: 50px;
        text-align: center;
        display: block;
        box-sizing: border-box;
      }

      .white-logo {
        width: 30%;
        max-width: 170px;
        display: block;
        margin: 0 auto;
      }

      .white-logo path[fill="#1c1c1c"] {
        fill: white;
      }

      .logo-title{
        font-size: 1.6rem;
        text-align: center;
        color: #19a160;
      }

      .title {
        font-size: 1.4rem;
        text-align: center;
        font-weight: 400;
      }

      .nissan {
        width: 60%;
        max-height: 150px;
        max-height: 150px;
      }

      .form__location-remove.link {
        display: none;
      }

      .form__location:nth-child(n+3) .link {
        display: block;
      }

      .form__location:nth-child(7) + button#add_point {
        display: none !important;
      }

      fieldset .loader {
        text-align: center;
      }

      fieldset .loader svg {
        max-width: 150px;
      }

      .hidden {
        display: none;
      }

      .loader ellipse[stroke-dasharray] {
        animation: dash .3s linear infinite;
      }

  body
    = render 'shared/localization'
    main= yield
    = javascript_include_tag 'pwa', async: true
    = javascript_pack_tag 'application', async: true, defer: true
    = stylesheet_link_tag 'pwa', media: :none, onload: "if(media!='all')media='all'"
    = render 'shared/schema_org'
    script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDx2cLwlAG3muHMV9DVYY3l2PupoYCS-Mk&libraries=places" async=true defer=true
    script id="widget-wfp-script" language="javascript" type="text/javascript" src="https://secure.wayforpay.com/server/pay-widget.js" async=true defer=true
