css:
  :root {
    --white: white;
    --shadow_color: #24293038;
    --shadow_color_light: white;
    --bg_gradient_color_1:  #eef6fb;
    --bg_gradient_color_2:  #eef6fb;
    --top_gradient: linear-gradient(0deg,
      rgba(255, 255, 255, 0),
      rgba(255, 255, 255, 0) 0%,
      var(--bg_gradient_color_2) 100%,
      var(--bg_gradient_color_2));
    --input_bg_color: #E9EEED;
  }
