html lang='uk'
  head
    = stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'application', 'data-turbolinks-track': 'reload'
    = javascript_pack_tag 'application'
    = render 'layouts/head'

    css:
      html {
        overflow-x: hidden;
      }
      fieldset[disabled] { display: none; }
      button[disabled] {
        opacity: 0.5;
      }
      body {
        background: #e1e1e1;
        background: linear-gradient(white, #d1d1d1);
        color: #1c1c1c;
      }

      [class*='icon'] {
        max-width: 40px;
        max-height: 40px;
        vertical-align: middle;
      }

      .black-logo, .white-logo {
        max-width: 150px;
      }

      .badges svg {
        max-width: 200px;
        max-height: 200px;
      }

  body
    = render 'shared/navbar'
    = yield
    = stylesheet_link_tag    'fonts', media: 'all'
  = render 'layouts/footer'
