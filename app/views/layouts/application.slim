html lang=I18n.locale
  head
    meta property='og:url' content='https://cablook.taxi'
    meta property='og:type' content='website'
    meta property='og:title' content='Замовити таксі по місту Черкаси | CabLook Taxi'
    meta property='og:description' content='Швидкий сервіс замовити таксі по місту Черкаси. Завжди поруч, завжди вчасно || Бонус+: отримай БЕЗКОШТОВНІ поїздкі'
    meta property='og:image' content='https://i.imgur.com/VY8ZmVI.jpg'
    script src='https://www.googletagmanager.com/gtag/js?id=UA-111386040-1' async=true
    meta http-equiv='Content-type' content='text/html; charset=utf-8'
    meta name='viewport' content='initial-scale=1, maximum-scale=1'
    title= t("#{params[:controller]}.#{params[:page]}.meta_title", default: t('head.title'))
    meta name='description' content= t("#{params[:controller]}.#{params[:page]}.meta_description", default: t('head.description'))
    = csrf_meta_tags
    = render 'shared/favicon_links'
    javascript:
      window._TOKEN = "#{ENV['WAYFORPAY_SECRET']}"
      window._MERCHANT = "#{ENV['WAYFORPAY_MERCHANT']}"
    css:
      html {
        overflow-x: hidden;
      }
      fieldset[disabled] { display: none; }
      body {
        background: #e1e1e1;
        background: linear-gradient(white, #d1d1d1);
        color: #1c1c1c;
      }

      [class*='icon'] {
        max-width: 40px;
        max-height: 40px;
        vertical-align: middle;
      }

      .black-logo, .white-logo {
        max-width: 150px;
      }

  body
    = render 'shared/navbar'
    = yield
    = stylesheet_link_tag    'application', media: 'all'
    = javascript_include_tag 'application', async: true
    = stylesheet_link_tag    'fonts', media: 'all'
  = render 'shared/schema_org'
  script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDlGdVGbkeO_30Yn7tPCpe61AgdrsXMbQ0&libraries=places" async=true defer=true
  script id="widget-wfp-script" language="javascript" type="text/javascript" src="https://secure.wayforpay.com/server/pay-widget.js"

  javascript:
    wayforpay = new Wayforpay();
    var pay = function () {
      wayforpay.run((new WFP),
        function (response) {
          setTimeout(function(){
            wayforpay.closeit()
            Cards.create(response)
          }, 1000)
        },
        function (response) {
          UI.disableButtons(false)
          alert(response)
        },
        function (response) {
          UI.disableButtons(false)
          alert(response)
        }
      );
    }
