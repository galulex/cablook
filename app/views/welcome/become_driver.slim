main.content.become-driver
  a href=root_path
    = inline_svg 'logo.svg', class: 'black-logo'
    div.logo-title
      b CAB
      | LOOK
  h1
    p = t('.title')
  = inline_svg 'stars.svg', class: 'svgs stars'
  h1.description = t('.description')

  h1 = t('.car_opportunities')
  p = t('.car_opportunities_text')

  h1 = t('.our_mission_title')
  p = t('.our_mission_text')

  h1 = t('.our_values_title')
  .benefits
      - t('.our_values_text').each do |o|
        p= o

  h1 = t('.benefits_title')
  = inline_svg 'thumbs_up.svg', class: 'svgs thumbs_up'
  .benefits
      - t('.benefits').each do |o|
        p= o
  
  h1 = t('.how_it_works_title')
  = inline_svg 'gears.svg', class: 'svgs gears'
  .how-it-works
    ol
      - t('.how_it_works').each do |o|
        li= o

  h1.driver = t('.form_title')
  = form_for :cv, url: driver_request_path, autocomplete: false, html: { id: 'become-driver-form', class: 'become-driver-form' } do |f|
    .col-6
      b = f.label :name
        = t('.form_fields.name')
      = f.text_field :name, required: :true, autocomplete: 'off'

    .col-6
      b = f.label :surname
        = t('.form_fields.surname')
      = f.text_field :surname, required: :true, autocomplete: 'off'

    .col-6
      b = f.label :phone 
        = t('.form_fields.phone')
      = f.text_field :phone, required: :true, autocomplete: 'off'

    .col-6
      b = f.label :email
        = t('.form_fields.email')
      = f.email_field :email, autocomplete: 'off'

    .col-12
      b = f.label :comment
        = t('.form_fields.comment')
      = f.text_area :comment, rows: 2, autocomplete: 'off'
    .col-12
      = f.submit t('.form_fields.submit'), class: 'btn'


  = inline_svg 'city.svg', class: 'city violet'
