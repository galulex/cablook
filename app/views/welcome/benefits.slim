main.content.benefits
  a href=root_path
    = inline_svg 'logo.svg', class: 'black-logo'
    div.logo-title
      b CAB
      | LOOK
  h1= t('.title')
  ul.benefits
    - b = t('.benefits').first
    li.benefit.odd
      = inline_svg "#{b[:img]}.svg", class: 'list-icon'
      h2= b[:title]
      p= b[:description]
    - b = t('.benefits').last
    li.benefit
      = inline_svg "#{b[:img]}.svg", class: 'list-icon'
      h2= b[:title]
      p= b[:description]
      p
        b= t('.opportunity')
        ul
          - t('.opportunities').each do |o|
            li= o
  br
  = inline_svg 'city.svg', class: 'city violet'
