main.content.why
  = inline_svg 'logo.svg', class: 'black-logo'
  div.logo-title
    b CAB
    | LOOK
  h2= t('.why')
  h1= t('.title')
  ul.benefits.odd
    - t('.benefits').each do |b|
      li.benefit class=cycle('', 'odd')
        = inline_svg "#{b[:img]}.svg", class: 'list-icon'
        h2= b[:title]
        p= b[:description]
  = inline_svg 'city.svg', class: 'city violet'
