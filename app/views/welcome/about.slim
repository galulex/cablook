main.content.about
  = inline_svg 'logo.svg', class: 'header__logo'
  h3.= t('.title')
  ul.about-section
    - I18n.t('welcome.index.logos').each do |key, value|
      li.welcome-section__item.col-6
        = inline_svg "welcome/#{key}", class: "welcome-section__image"
        h2 class="welcome-section__title--#{key}"
          = value[:title]
        .about-section__description= value[:description]
  = inline_svg 'city.svg', class: 'city violet'
