main.welcome.content role='main'
  = inline_svg 'logo.svg', class: 'white-logo'
  div.logo-title
    b CAB
    | LOOK
  h1.title= t('.title')
  label.col-12.btn for='menu' = t('order')
  br
  a.pd href='#' style='opacity: 0.2; poniter-events: none;'
    = inline_svg 'applestore.svg', class: 'icon-2x'
  a.pd href='https://play.google.com/store/apps/details?id=com.cablook' target=:_blank
    = inline_svg 'googleplay.svg', class: 'icon-2x'
  h2.title.green= t('.subtitle')
  ul
    li= t('.download')
    li= t('.share')
    li= t('.receive')

  = inline_svg 'city.svg', class: :city
  .city-road
    = inline_svg 'nissan.svg', class: :nissan, id: :nissan
    = inline_svg 'road.svg', class: :road
