input#menu type='checkbox'
label for='menu'
nav
  .main-menu
    .main-menu__header
      a href=root_path
        = inline_svg 'cablook', class: 'main-menu__logo icon'
      .main-menu__title= t('.order')
    = render 'shared/user_form'
    => link_to page_path(:about), class: 'menu-item' do
      => inline_svg 'leaf', class: :icon
      = t('.about_us')
    => link_to page_path(:why), class: 'menu-item' do
      => inline_svg 'pin', class: :icon
      = t('.why')
    => link_to page_path(:about), class: 'menu-item' do
      => inline_svg 'faq', class: :icon
      ' FAQ
    => link_to page_path(:benefits), class: 'menu-item' do
      => inline_svg 'car', class: :icon
      = t('.benefits')
  .bottom-menu
    .bottom-menu__languages
      .bottom-menu__locale
        / = link_to_unless_current 'UA', welcome_path(nil), class: 'bottom-menu__locale--link'
      / | /
      / .bottom-menu__locale
        / = link_to_unless_current 'RU', welcome_path(:ru), class: 'bottom-menu__locale--link'
