input#menu type='checkbox'
label.menu-trigger for='menu'
nav
  .main-menu
    .main-menu__header
      = inline_svg 'cablook', class: 'main-menu__logo icon'
      = t('.order')
    = render 'shared/user_form'
    = link_to page_path(:about), class: 'menu-item' do
      => inline_svg 'leaf', class: :icon
      = t('.about_us')
    = link_to page_path(:why), class: 'menu-item' do
      => inline_svg 'pin', class: :icon
      = t('.why')
    = link_to page_path(:faq), class: 'menu-item' do
      => inline_svg 'faq', class: :icon
      ' FAQ
    = link_to page_path(:benefits), class: 'menu-item' do
      => inline_svg 'car', class: :icon
      = t('.benefits')
    = link_to page_path(:contacts), class: 'contacts' do
      => inline_svg 'contact', class: :icon
      = t('.contacts')
  .bottom-menu
    .bottom-menu__rights
      div CabLook Taxi
      div Україна
      div © 2018 CabLook Taxi. All Rights Reserved
