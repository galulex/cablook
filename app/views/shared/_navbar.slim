input#menu type='checkbox'
label.menu-trigger for='menu'
nav
  .main-menu
    = link_to pwa_url(host: 'cablook.taxi'), class: 'menu-item', target: :_blank do
      => inline_svg 'cablook', class: :icon
      = t('.order')
    = link_to page_path(:about), class: 'menu-item' do
      => inline_svg 'leaf', class: :icon
      = t('.about_us')
    = link_to page_path(:why), class: 'menu-item' do
      => inline_svg 'pin', class: :icon
      = t('.why')
    = link_to page_path(:faq), class: 'menu-item' do
      => inline_svg 'faq', class: :icon
      ' FAQ
    = link_to page_path(:benefits), class: 'menu-item' do
      => inline_svg 'car', class: :icon
      = t('.benefits')
    = link_to ext_opp_path, class: 'menu-item' do
      => inline_svg 'extended_opp-s', class: :icon
      =t('.ext_opportunities')
    = link_to page_path(:contacts), class: 'contacts' do
      => inline_svg 'contact', class: :icon
      = t('.contacts')

    div.badges
      a.col-8 href=pwa_url(host: 'cablook.taxi') target=:_blank
        = inline_svg 'pwa_badge.svg'
      a.col-8 href='https://play.google.com/store/apps/details?id=com.cablook&pcampaignid=MKT-Other-global-all-co-prtnr-py-PartBadge-Mar2515-1' target=:_black
        = inline_svg 'google_play_badge.svg'
      a.col-8 href='https://itunes.apple.com/us/app/cablook-taxi/id1356063043?ls=1&mt=8' target=:_black
        = inline_svg 'app_store_badge.svg'

  .bottom-menu
    .bottom-menu__localization
      .flag
        = link_to locale_path(:uk)
          = inline_svg 'ua_flag.svg', width: '23', height: '15', alt: 'Ukraine'
      .flag
        = link_to locale_path(:ru)
          = inline_svg 'ru_flag.svg', width: '23', height: '15', alt: 'Russia'
    .bottom-menu__rights
      div CabLook Taxi
      div Україна
      div © 2018 CabLook Taxi. All Rights Reserved

