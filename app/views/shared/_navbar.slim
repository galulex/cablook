input#menu type='checkbox'
label for='menu'
nav
  .main-menu
    .main-menu__header
      = inline_svg 'white_logo', class: 'main-menu__logo'
      .main-menu__title= t('nav_bar.order')
    = render 'shared/user_form'
    = link_to t('nav_bar.be_driver'), welcome_path
    = link_to t('nav_bar.about_us'), welcome_path
  .bottom-menu
    = link_to t('nav_bar.contacts'), welcome_path
    .bottom-menu__languages
      .bottom-menu__locale
        = link_to_unless_current 'UA', welcome_path(nil), class: 'bottom-menu__locale--link'
      | /
      .bottom-menu__locale
        = link_to_unless_current 'RU', welcome_path(:ru), class: 'bottom-menu__locale--link'
