form.form
  fieldset.form__fieldset.form__fieldset--short
    label.form__number-label for=:number +380
    input.form__number#number type=:number min=100_000_000 max=999_999_999 required=true placeholder=123456789 onkeydown='Sessions.create(event)'
  fieldset.form__fieldset disabled=true
    input#verification type=:number min=1_000 max=9_999 required=true pattern='.{4}' placeholder=1234 onkeydown='Sessions.update(event)' data-message= t('.wrong_code')
    label for=:verification
      = t('.sms')
    button type=:button  onclick='Sessions.destroy()'
      = t('.change_number')
  fieldset.form__fieldset disabled=true
    button type=:button onclick='Sessions.destroy()'
      = t('.sign_out')
    div.form__user-number#account
    .form__location
      input.form__location-field#from type=:text required=true placeholder= t('.from')
      ul.form__location-list data-list=true
    input.form__location-field#to type=:text required=true placeholder= t('.to') oninput='app.autocomplete(this)'
  fieldset.form__fieldset disabled=true
    div#state
      .loader
      | Одну хвилину підбираємо водія
    button#cancel type=:button onclick='Trips.cancel()' Cancel
